    <string name="publish_creation_type_header">Creation type*</string>
    <string name="publish_creation_type_subtitle">If your song reworks an existing work (such as an arrangement of Canon in D), choose Derivative and fill in the original. If it reworks a Hachimi song (such as a cover), choose Tertiary derivative.</string>
