    <string name="publish_title_header">Title*</string>
    <string name="publish_title_subtitle">Use plain text. Don't put tags, emoji or symbols in the title, e.g. 钢铁雄基, 哈基哈基天使</string>
    <string name="publish_subtitle_header">Subtitle</string>
    <string name="publish_subtitle_subtitle">Optional. Usually a short description, or where an OST comes from, such as an anime OP or a game soundtrack.</string>
    <string name="publish_tags_header">Tags</string>
    <string name="publish_tags_subtitle">Describe the genre (e.g. Classical, Pop, J-Pop, ACG, R&amp;B) and the kind of creation (e.g. 纯净哈基米, 原曲不使用).\nAvoid adding too many tags. For English tags, capitalize each word and separate words with spaces, or use the standard spelling. Don't use symbols or emoji.</string>
    <string name="publish_description_header">Description</string>
    <string name="publish_description_subtitle">Introduce your song, tell a story, or describe how you made it</string>
    <string name="publish_lyrics_header">Lyrics</string>
    <string name="publish_lyrics_subtitle">Synced lyrics in LRC format are recommended</string>
