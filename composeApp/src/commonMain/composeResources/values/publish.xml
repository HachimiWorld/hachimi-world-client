    <!-- Publish screen -->
    <string name="publish_screen_title_create">Publish a song</string>
    <string name="publish_screen_title_edit">Edit song</string>
    <string name="publish_notice">Before you submit:\nWe respect the work of every creator, so we don't accept reposts of other people's works.\nIf this is your first submission, you can link your Bilibili account on your profile page, which helps us confirm that you are the author.\nFor now we don't accept:\n1. Very short works (we suggest at least one full section);\n2. Works unrelated to Hachimi music;\n3. Works unsuitable for the site (such as politically sensitive content).</string>
    <string name="publish_audio_header">Audio*</string>
